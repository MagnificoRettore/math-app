                  "id": "ms-prop-1",
                  "title": "Termine incognito in una proporzione",
                  "difficulty": "medium",
                  "tags": ["proporzioni"],
                  "problem": "Risolvi la proporzione:\n\n$$6 : 9 = x : 12$$",
                  "formulas": [
                    "$$\\frac{a}{b} = \\frac{c}{d} \\implies a \\cdot d = b \\cdot c$$"
                  ],
                  "hints": [
                    "Applica la proprietà fondamentale: prodotto dei medi = prodotto degli estremi."
                  ],
                  "steps": [
                    "Proprietà fondamentale: $$6 \\cdot 12 = 9 \\cdot x$$",
                    "Calcola: 72 = 9x.",
                    "Dividi per 9: $$x = \\frac{72}{9} = 8$$"
                  ]
                }
              ]
            },
