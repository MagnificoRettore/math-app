              "title": "Frazioni",
              "subtitle": "Confronto e operazioni",
              "icon": "pie_chart",
              "exercises": [
                {
                  "id": "ms-frac-compare-1",
                  "title": "Confronto di frazioni",
                  "difficulty": "easy",
                  "tags": ["frazioni", "confronto"],
                  "problem": "Quale frazione è maggiore: $$\\frac{3}{4}$$ o $$\\frac{2}{3}$$?",
                  "formulas": [
                    "$$\\frac{a}{b} > \\frac{c}{d} \\iff a \\cdot d > c \\cdot b$$"
                  ],
                  "hints": [
                    "Porta le due frazioni allo stesso denominatore, ad esempio 12."
                  ],
                  "steps": [
                    "Denominatore comune: 12 (m.c.m. tra 4 e 3).",
                    "Trasforma: $$\\frac{3}{4} = \\frac{9}{12}$$ e $$\\frac{2}{3} = \\frac{8}{12}$$",
                    "Poiché 9 > 8, si ha $$\\frac{3}{4} > \\frac{2}{3}$$."
                  ]
                },
                {
                  "id": "ms-frac-sum-1",
                  "title": "Somma di frazioni diverse",
                  "difficulty": "medium",
                  "tags": ["frazioni", "somma"],
                  "problem": "Calcola la somma:\n\n$$\\frac{1}{2} + \\frac{1}{3}$$",
                  "formulas": [
                    "$$\\frac{a}{b} + \\frac{c}{d} = \\frac{a \\cdot d + c \\cdot b}{b \\cdot d}$$"
                  ],
                  "hints": [
                    "Trova un denominatore comune tra 2 e 3."
                  ],
                  "steps": [
                    "Il denominatore comune è 6.",
                    "Trasforma: $$\\frac{1}{2} = \\frac{3}{6}$$ e $$\\frac{1}{3} = \\frac{2}{6}$$",
                    "Somma: $$\\frac{3}{6} + \\frac{2}{6} = \\frac{5}{6}$$"
                  ]
                }
              ]
            },
            {
              "id": "ms1-percentage",
              "title": "Percentuali",
              "subtitle": "Calcolo di percentuali",
              "icon": "percent",
              "exercises": [
                {
                  "id": "ms-perc-1",
                  "title": "Sconto percentuale",
                  "difficulty": "medium",
                  "tags": ["percentuali", "sconto"],
                  "problem": "Un paio di scarpe costa 80€. Durante i saldi lo sconto è del 25%. Qual è il prezzo scontato?",
                  "formulas": [
                    "$$\\text{sconto} = \\frac{p}{100} \\cdot \\text{prezzo}$$"
                  ],
                  "hints": [
                    "Calcola prima l'importo dello sconto, poi sottrailo dal prezzo originale."
                  ],
                  "steps": [
                    "Sconto: $$\\frac{25}{100} \\cdot 80 = 20$$€",
                    "Prezzo scontato: 80 − 20 = 60€."
                  ]
                }
              ]
            }
          ]
        }
      ]
