                  "id": "ms-eq-1",
                  "title": "Equazione lineare semplice",
                  "difficulty": "easy",
                  "tags": ["equazioni", "primo grado"],
                  "problem": "Risolvi l'equazione:\n\n$$3x + 4 = 13$$",
                  "formulas": [],
                  "hints": [
                    "Porta il termine noto a destra cambiando segno."
                  ],
                  "steps": [
                    "Sottrai 4 da entrambi i membri: $$3x = 13 - 4$$",
                    "Calcola: $$3x = 9$$",
                    "Dividi per 3: $$x = 3$$"
                  ]
                }
              ]
            }
