                  "difficulty": "easy",
                  "tags": ["logaritmi"],
                  "problem": "Calcola:\n\n$$\\log_2 8$$",
                  "formulas": [
                    "$$\\log_a b = c \\iff a^c = b$$ (con a > 0, a ≠ 1, b > 0)"
                  ],
                  "hints": [
                    "Chiediti a quale esponente elevare 2 per ottenere 8."
                  ],
                  "steps": [
                    "Devi trovare c tale che $$2^c = 8$$.",
                    "Si ha $$8 = 2^3$$.",
                    "Quindi $$\\log_2 8 = 3$$."
                  ]
                },
                {
                  "id": "log-medium-1",
