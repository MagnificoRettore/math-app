                  "difficulty": "easy",
                  "tags": ["moduli", "valore assoluto"],
                  "problem": "Calcola il valore assoluto di ciascun numero: $$|7|$$, $$|-7|$$.",
                  "formulas": [
                    "$$|x| = \\begin{cases} x & \\text{se } x \\ge 0 \\\\ -x & \\text{se } x < 0 \\end{cases}$$"
                  ],
                  "hints": [
                    "Il valore assoluto di un numero è la distanza dallo zero sulla retta reale.",
                    "Il risultato non può mai essere negativo."
                  ],
                  "steps": [
                    "Per definizione: $$|7| = 7$$ perché 7 ≥ 0.",
                    "Per definizione: $$|-7| = -(-7) = 7$$ perché -7 < 0.",
                    "Risultato: $$|7| = 7$$ e $$|-7| = 7$$."
                  ]
                },
                {
                  "id": "mod-medium-1",
                  "title": "Equazione con modulo semplice",
                  "difficulty": "medium",
                  "tags": ["moduli", "equazioni", "valore assoluto"],
                  "problem": "Risolvi l'equazione:\n\n$$|x| = 5$$",
                  "formulas": [
                    "$$|x| = a \\iff x = a \\lor x = -a \\quad (a \\ge 0)$$"
                  ],
                  "hints": [
                    "Se |x| = a con a ≥ 0, allora x può essere a oppure -a.",
                    "Ricorda di verificare i due casi."
                  ],
                  "steps": [
                    "L'equazione |x| = 5 si traduce nella disgiunzione di due casi.",
                    "Caso 1: x = 5.",
                    "Caso 2: x = -5.",
                    "Soluzioni: x = 5 oppure x = -5."
                  ]
                }
              ]
            }
