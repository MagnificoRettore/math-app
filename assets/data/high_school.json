              "exercises": [
                {
                  "id": "frac-easy-1",
                  "title": "Somma di frazioni",
                  "difficulty": "easy",
                  "tags": ["frazioni", "somma"],
                  "problem": "Calcola la seguente somma di frazioni:\n\n$$\\frac{2}{3} + \\frac{1}{6}$$",
                  "formulas": [
                    "$$\\frac{a}{b} + \\frac{c}{d} = \\frac{a \\cdot d + c \\cdot b}{b \\cdot d}$$"
                  ],
                  "hints": [
                    "Come prima cosa porta le frazioni allo stesso denominatore (m.c.m.).",
                    "Il m.c.m. tra 3 e 6 è 6."
                  ],
                  "steps": [
                    "Il denominatore comune tra 3 e 6 è 6.",
                    "Trasforma la prima frazione: $$\\frac{2}{3} = \\frac{2 \\cdot 2}{3 \\cdot 2} = \\frac{4}{6}$$",
                    "Somma i numeratori: $$\\frac{4}{6} + \\frac{1}{6} = \\frac{4 + 1}{6} = \\frac{5}{6}$$",
                    "La frazione $$\\frac{5}{6}$$ è già ridotta ai minimi termini perché 5 e 6 non hanno divisori comuni."
                  ]
                },
                {
                  "id": "frac-hard-1",
                  "title": "Espressione con frazioni",
                  "difficulty": "hard",
                  "tags": ["frazioni", "espressioni"],
                  "problem": "Risolvi la seguente espressione:\n\n$$\\left(\\frac{3}{4} + \\frac{1}{2}\\right) \\cdot \\frac{2}{5} - \\frac{1}{10}$$",
                  "formulas": [
                    "$$\\frac{a}{b} \\cdot \\frac{c}{d} = \\frac{a \\cdot c}{b \\cdot d}$$"
                  ],
                  "hints": [
                    "Risolvi prima la parentesi: porta a denominatore comune 3/4 e 1/2.",
                    "Ricorda che la moltiplicazione ha priorità sulla sottrazione."
                  ],
                  "steps": [
                    "Dentro la parentesi: $$\\frac{3}{4} + \\frac{1}{2} = \\frac{3}{4} + \\frac{2}{4} = \\frac{5}{4}$$",
                    "Moltiplica: $$\\frac{5}{4} \\cdot \\frac{2}{5} = \\frac{5 \\cdot 2}{4 \\cdot 5} = \\frac{10}{20} = \\frac{1}{2}$$",
                    "Sottrai: $$\\frac{1}{2} - \\frac{1}{10} = \\frac{5}{10} - \\frac{1}{10} = \\frac{4}{10} = \\frac{2}{5}$$",
                    "Il risultato è $$\\frac{2}{5}$$."
                  ]
                }
              ]
            }
          ]
        },
