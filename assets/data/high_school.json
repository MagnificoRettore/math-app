                  "problem": "Risolvi l'equazione:\n\n$$2^x = 32$$",
                  "formulas": [
                    "$$a^m = a^n \\iff m = n$$ (con a > 0, a ≠ 1)"
                  ],
                  "hints": [
                    "Riscrivi 32 come potenza di 2.",
                    "Quando le basi sono uguali, uguaglia gli esponenti."
                  ],
                  "steps": [
                    "Riscrivi 32 come potenza di 2: $$32 = 2^5$$",
                    "L'equazione diventa: $$2^x = 2^5$$",
                    "Le basi sono uguali, quindi uguaglia gli esponenti: x = 5."
                  ]
                },
                {
                  "id": "exp-medium-1",
                  "title": "Equazione con termine esponente composto",
                  "difficulty": "medium",
                  "tags": ["esponenziali", "equazioni"],
                  "problem": "Risolvi l'equazione:\n\n$$3^{x+1} = 27$$",
                  "formulas": [
                    "$$a^m = a^n \\iff m = n$$ (con a > 0, a ≠ 1)"
                  ],
                  "hints": [
                    "Riscrivi 27 come potenza di 3.",
                    "Uguaglia gli esponenti e risolvi l'equazione di primo grado."
                  ],
                  "steps": [
                    "Riscrivi 27 come potenza di 3: $$27 = 3^3$$",
                    "L'equazione diventa: $$3^{x+1} = 3^3$$",
                    "Uguaglia gli esponenti: x + 1 = 3",
                    "Risolvi: x = 2."
                  ]
                }
              ]
            },
