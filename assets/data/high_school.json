                  "difficulty": "medium",
                  "tags": ["logaritmi", "equazioni"],
                  "problem": "Risolvi l'equazione:\n\n$$\\log_3 (x+1) = 2$$",
                  "formulas": [
                    "$$\\log_a b = c \\iff a^c = b$$"
                  ],
                  "hints": [
                    "Applica la definizione di logaritmo passando alla forma esponenziale.",
                    "Verifica che il risultato rispetti la condizione di esistenza x + 1 > 0."
                  ],
                  "steps": [
                    "Per definizione di logaritmo: $$x + 1 = 3^2$$",
                    "Calcola: x + 1 = 9",
                    "Risolvi: x = 8.",
                    "Condizione di esistenza: x + 1 = 9 > 0, quindi accettabile."
                  ]
                }
              ]
            }
          ]
