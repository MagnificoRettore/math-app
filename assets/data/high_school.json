                  "formulas": [
                    "$$\\frac{d}{dx} x^n = n \\cdot x^{n-1}$$",
                    "$$\\frac{d}{dx} [f(x) + g(x)] = f'(x) + g'(x)$$"
                  ],
                  "hints": [
                    "Deriva ogni termine della somma separatamente.",
                    "Abbassa l'esponente come coefficiente e diminuiscilo di 1."
                  ],
                  "steps": [
                    "Derivata di $$3x^2$$: $$3 \\cdot 2x^{2-1} = 6x$$",
                    "Derivata di $$2x$$: $$2$$",
                    "Somma le derivate: $$f'(x) = 6x + 2$$"
                  ]
                }
              ]
